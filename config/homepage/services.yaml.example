    - Uptime Kuma:
        href: https://status.robynshomelab.dev/status/homelab
        description: Service Monitoring
        icon: uptime-kuma.png
        widget:
          type: uptimekuma
          url: http://192.168.20.95:3001
          slug: homelab

    - PVE-1:
        href: https://beszel.robynshomelab.dev
        description: Proxmox Host
        icon: proxmox.png
        widget:
          type: customapi
          url: http://192.168.20.100:61209/stats
          refreshInterval: 10000
          display: list
          mappings:
            - field: cpu
              label: CPU
              format: number
              suffix: "%"
            - field: memory
              label: RAM
              format: number
              suffix: "%"
            - field: swap
              label: Swap
              format: number
              suffix: "%"
            - field: temperature
              label: Temp
              format: number
              suffix: "°C"
            - field: root
              label: Root
              format: number
              suffix: "%"
            - field: uptime
              label: Uptime
              format: text

    - PVE-2:
        href: https://beszel.robynshomelab.dev
